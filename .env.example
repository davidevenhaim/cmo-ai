# APPLICATION / INFRASTRUCTURE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cmo
BRAIN_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development
BRAIN_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# SEARCH
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
BRAVE_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# CRAWL — default: Crawl4AI with Browserless fallback
# CRAWL_PROVIDER=crawl4ai|browser|firecrawl|chain|crawl4ai-only
# ---------------------------------------------------------------------------
CRAWL_PROVIDER=crawl4ai
CRAWL4AI_BASE_URL=http://crawl4ai:11235
BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TOKEN=
BROWSER_ACTION_TIMEOUT_MS=20000
FIRECRAWL_API_KEY=
RESEARCH_REQUEST_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# EMAIL (listmonk) — leave blank to keep MockEmailProvider
# Start with: docker compose --profile email up -d
# ---------------------------------------------------------------------------
LISTMONK_BASE_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=
LISTMONK_FROM_EMAIL=
LISTMONK_TX_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# ANALYTICS (Umami) — optional; GA4 remains optional cloud
# Start with: docker compose --profile analytics up -d
# ---------------------------------------------------------------------------
UMAMI_BASE_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_TOKEN=
UMAMI_USE_MOCK=
UMAMI_APP_SECRET=replace-me-umami-app-secret
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GA4_USE_MOCK=

# ---------------------------------------------------------------------------
# CHANGEDETECTION — webhook token only (never log/store in findings as secret)
# Start with: docker compose --profile watch up -d
# ---------------------------------------------------------------------------
CHANGEDETECTION_WEBHOOK_TOKEN=
CHANGEDETECTION_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# TELEGRAM
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BRIEF_CRON=0 9 * * *

# ---------------------------------------------------------------------------
# SHOPIFY — credentials only
# ---------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_API_VERSION=2024-10
SHOPIFY_REQUEST_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# WAHA
# ---------------------------------------------------------------------------
WAHA_BASE_URL=
WAHA_SESSION=default

# ---------------------------------------------------------------------------
# WORDPRESS
# ---------------------------------------------------------------------------
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# ---------------------------------------------------------------------------
# POSTIZ
# ---------------------------------------------------------------------------
POSTIZ_BASE_URL=
POSTIZ_API_KEY=

# ---------------------------------------------------------------------------
# GOOGLE / market intelligence (optional; mocks when blank)
# ---------------------------------------------------------------------------
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
SERPAPI_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# BOOTSTRAP DEFAULTS — first seed only; Admin Settings win afterwards
# ---------------------------------------------------------------------------
SHOPIFY_DEFAULT_PERIOD_DAYS=30
SHOPIFY_LOW_STOCK_THRESHOLD=5
REVENUE_MAX_DISCOUNT_PCT=20
REVENUE_MIN_MARGIN_PCT=15
REVENUE_MIN_ORDER_VALUE=30
REVENUE_MAX_DISCOUNTS_PER_JOURNEY=2
REVENUE_MIN_HOURS_BEFORE_DISCOUNT=6
REVENUE_RECOVERY_LADDER_HOURS=1,6,24,48
REVENUE_WIN_BACK_DAYS=90
REVENUE_VIP_LTV_THRESHOLD=500
REVENUE_FREE_SHIPPING_NEAR_FACTOR=0.8
