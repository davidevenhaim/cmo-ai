DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cmo
CLAUDE_API_KEY=sk-ant-...
BRAIN_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development

# Telegram — leave blank to disable bot; dev/simulate endpoint still works in development
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to interact with the bot
# Required in non-development environments when TELEGRAM_BOT_TOKEN is set
TELEGRAM_ALLOWED_CHAT_IDS=
# Secret passed to Telegram setWebhook — must match X-Telegram-Bot-Api-Secret-Token header
# Required in non-development environments when TELEGRAM_BOT_TOKEN is set (startup fails otherwise)
TELEGRAM_WEBHOOK_SECRET=
# Cron expression for daily brief (default: 09:00 every day)
TELEGRAM_BRIEF_CRON=0 9 * * *

# Brain — HTTP timeout for calls to the Python brain service in milliseconds
BRAIN_TIMEOUT_MS=30000

# Research — leave both blank to disable external research providers
# Search: Brave Search API (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=
# Crawl: Firecrawl (https://firecrawl.dev)
FIRECRAWL_API_KEY=
# Shared timeout for research HTTP requests (ms)
RESEARCH_REQUEST_TIMEOUT_MS=10000

# Shopify — leave blank to disable; commerce data will be unavailable
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_API_VERSION=2024-10
# Number of days to include in the current period metrics window
SHOPIFY_DEFAULT_PERIOD_DAYS=30
# Units at or below this threshold are flagged as low stock
SHOPIFY_LOW_STOCK_THRESHOLD=5
# HTTP timeout for Shopify API requests in milliseconds
SHOPIFY_REQUEST_TIMEOUT_MS=10000

# WAHA (WhatsApp HTTP API, https://waha.devlike.pro) — leave blank to disable
# WhatsApp sending; recovery journeys will skip send steps as not configured
WAHA_BASE_URL=
# WAHA session name (default: default)
WAHA_SESSION=default

# WordPress — leave blank to disable blog publishing
# REST API base URL, e.g. https://your-site.com
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
# Application password (WordPress admin → Users → Application Passwords)
WORDPRESS_APPLICATION_PASSWORD=

# Postiz (social scheduling, https://postiz.com) — leave blank to disable social publishing
POSTIZ_BASE_URL=
POSTIZ_API_KEY=

# Google Search Console — leave blank to use mock provider (data marked MOCK,
# excluded from scoring). Create a service account in Google Cloud, grant it
# read-only access in Search Console, base64-encode the JSON key.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Trends via SerpAPI — leave blank to use mock provider
SERPAPI_KEY=
# Google Ads Keyword Planner (read-only keyword ideas) — leave blank to use mock provider
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Revenue policy — business rules for recovery offers; defaults shown.
# Hard cap on any discount percentage
REVENUE_MAX_DISCOUNT_PCT=20
# Minimum contribution margin (%) that must remain after discount
REVENUE_MIN_MARGIN_PCT=15
# Minimum cart value eligible for any offer
REVENUE_MIN_ORDER_VALUE=30
# Max discounts allowed per recovery journey
REVENUE_MAX_DISCOUNTS_PER_JOURNEY=2
# Hours after abandonment before any discount may be offered
REVENUE_MIN_HOURS_BEFORE_DISCOUNT=6
# Comma-separated journey step delays in hours after abandonment
REVENUE_RECOVERY_LADDER_HOURS=1,6,24,48
# Days without an order before a customer is win-back eligible
REVENUE_WIN_BACK_DAYS=90
# Lifetime value threshold for VIP treatment
REVENUE_VIP_LTV_THRESHOLD=500
# Carts at/above this fraction of the free-shipping threshold get a
# free-shipping nudge instead of a discount
REVENUE_FREE_SHIPPING_NEAR_FACTOR=0.8
