# APPLICATION / INFRASTRUCTURE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cmo
BRAIN_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development
# Nest -> brain. Must exceed OLLAMA_TIMEOUT_SECONDS; a local 30B model needs minutes.
BRAIN_TIMEOUT_MS=360000

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
# brain -> Ollama. Keep below BRAIN_TIMEOUT_MS so the brain reports the timeout.
OLLAMA_TIMEOUT_SECONDS=300
CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# SEARCH
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
BRAVE_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# CRAWL — default: Crawl4AI with Browserless fallback
# CRAWL_PROVIDER=crawl4ai|browser|firecrawl|chain|crawl4ai-only
# ---------------------------------------------------------------------------
CRAWL_PROVIDER=crawl4ai
CRAWL4AI_BASE_URL=http://crawl4ai:11235
# Required: crawl4ai >=0.9 serves loopback-only without a token, so the
# backend cannot reach it over the compose network. Same value both sides.
CRAWL4AI_API_TOKEN=local-dev-crawl4ai-token
BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TOKEN=
BROWSER_ACTION_TIMEOUT_MS=20000
FIRECRAWL_API_KEY=
RESEARCH_REQUEST_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# WEBSITE INTELLIGENCE (M9.6) — self-hosted Lighthouse
# The site URL and audit page list are BUSINESS configuration and live in the
# database (Website -> Settings). WEBSITE_URL below only seeds the row the
# first time; changing it later has no effect.
# ---------------------------------------------------------------------------
LIGHTHOUSE_BASE_URL=http://lighthouse:3010
WEBSITE_URL=
WEBSITE_AUDIT_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# EMAIL (listmonk) — leave blank to keep MockEmailProvider
# Start with: docker compose --profile email up -d
# ---------------------------------------------------------------------------
LISTMONK_BASE_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=
LISTMONK_FROM_EMAIL=
LISTMONK_TX_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# ANALYTICS (Umami) — optional; GA4 remains optional cloud
# Start with: docker compose --profile analytics up -d
# ---------------------------------------------------------------------------
UMAMI_BASE_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_TOKEN=
UMAMI_USE_MOCK=
UMAMI_APP_SECRET=replace-me-umami-app-secret
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GA4_USE_MOCK=

# ---------------------------------------------------------------------------
# CHANGEDETECTION — webhook token only (never log/store in findings as secret)
# Start with: docker compose --profile watch up -d
# ---------------------------------------------------------------------------
CHANGEDETECTION_WEBHOOK_TOKEN=
CHANGEDETECTION_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# TELEGRAM
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BRIEF_CRON=0 9 * * *

# ---------------------------------------------------------------------------
# SHOPIFY — credentials only
# ---------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_API_VERSION=2024-10
SHOPIFY_REQUEST_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# WAHA
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# WHATSAPP (WAHA) — start with: docker compose --profile whatsapp up -d
# Connect and scan the QR from the admin UI: WhatsApp -> Connection.
# ---------------------------------------------------------------------------
WAHA_BASE_URL=
WAHA_SESSION=default
# Set this if WAHA is reachable beyond the compose network.
WAHA_API_KEY=
WAHA_TIMEOUT_MS=15000
# Optional. When set, the /webhooks/waha endpoint requires this in
# X-Webhook-Secret.
WAHA_WEBHOOK_SECRET=
WAHA_ENGINE=WEBJS
# WAHA ships separate images per architecture. Use "arm" on Apple Silicon,
# "latest" on x86_64.
WAHA_IMAGE_TAG=latest
WAHA_HOOK_URL=http://backend:3001/webhooks/waha

# ---------------------------------------------------------------------------
# WORDPRESS
# ---------------------------------------------------------------------------
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# ---------------------------------------------------------------------------
# POSTIZ
# ---------------------------------------------------------------------------
POSTIZ_BASE_URL=
POSTIZ_API_KEY=

# ---------------------------------------------------------------------------
# GOOGLE / market intelligence (optional; mocks when blank)
# ---------------------------------------------------------------------------
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
SERPAPI_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# BOOTSTRAP DEFAULTS — first seed only; Admin Settings win afterwards
# ---------------------------------------------------------------------------
SHOPIFY_DEFAULT_PERIOD_DAYS=30
SHOPIFY_LOW_STOCK_THRESHOLD=5
REVENUE_MAX_DISCOUNT_PCT=20
REVENUE_MIN_MARGIN_PCT=15
REVENUE_MIN_ORDER_VALUE=30
REVENUE_MAX_DISCOUNTS_PER_JOURNEY=2
REVENUE_MIN_HOURS_BEFORE_DISCOUNT=6
REVENUE_RECOVERY_LADDER_HOURS=1,6,24,48
REVENUE_WIN_BACK_DAYS=90
REVENUE_VIP_LTV_THRESHOLD=500
REVENUE_FREE_SHIPPING_NEAR_FACTOR=0.8
